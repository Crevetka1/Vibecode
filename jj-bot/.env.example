# Токен от @BotFather (обязательно)
TELEGRAM_TOKEN=
# Канал/группа для сигналов (необязательно). Бота нужно сделать админом канала.
CHANNEL_ID=

# Котировки: NQ=F (фьючерс Nasdaq-100, есть цена до открытия) или ^NDX (индекс)
SYMBOL=NQ=F
INSTRUMENT_NAME=NAS100

# Сессия по времени Нью-Йорка (9:30–12:30 NY = 17:30–20:30 МСК зимой, 16:30–19:30 летом)
SESSION_START_NY=09:30
SESSION_END_NY=12:30

STOP_POINTS=25
TAKE_POINTS=38
RISK_USD=15

# Параметры сетапов
TIMEFRAME_MIN=5
MIN_DEVIATION=30
RETEST_TOLERANCE=8
SWEEP_LOOKBACK=6
MAX_TRADES_PER_SESSION=3

# Новости ForexFactory
NEWS_CURRENCY=USD
NEWS_FROM_NY=08:00
NEWS_BLACKOUT_MIN=5
